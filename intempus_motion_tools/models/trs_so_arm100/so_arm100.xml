<?xml version='1.0' encoding='utf-8'?>
<!-- Intempus model variant. See SOURCE.md for modifications and provenance. -->
<mujoco model="so_arm100">
  <compiler angle="radian" meshdir="assets" texturedir="assets" autolimits="true" eulerseq="zyx"/>

  <option timestep="0.002" solver="Newton" iterations="20" gravity="0 0 -9.81"/>

  <default>
    <default class="so_arm100">
      <joint frictionloss="0.1" armature="0.01" damping="1.0" limited="true"/>
      <geom condim="3" friction="1.0 0.1 0.1" solref="0.02 1" solimp="0.9 0.95 0.001" material="white"/>
      <motor ctrlrange="-1 1" ctrllimited="true"/>

      <default class="Rotation">
        <joint axis="0 1 0" range="-1.92 1.92" damping="2.0"/>
      </default>
      <default class="Pitch">
        <joint axis="1 0 0" range="-3.32 0.174" damping="1.5"/>
      </default>
      <default class="Elbow">
        <joint axis="1 0 0" range="-0.174 3.14" damping="1.5"/>
      </default>
      <default class="Wrist_Pitch">
        <joint axis="1 0 0" range="-1.66 1.66" damping="0.8"/>
      </default>
      <default class="Wrist_Roll">
        <joint axis="0 1 0" range="-2.79 2.79" damping="0.8"/>
      </default>
      <default class="Jaw">
        <joint axis="0 0 1" range="-0.174 1.75" damping="0.3"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="white" rgba="0.8 0.8 0.8 1"/>
    <material name="black" rgba="0.2 0.2 0.2 1"/>

    <mesh name="Base" file="Base.obj"/>
    <mesh name="Base_Motor" file="Base_Motor.obj"/>
    <mesh name="Rotation_Pitch" file="Rotation_Pitch.obj"/>
    <mesh name="Rotation_Pitch_Motor" file="Rotation_Pitch_Motor.obj"/>
    <mesh name="Upper_Arm" file="Upper_Arm.obj"/>
    <mesh name="Upper_Arm_Motor" file="Upper_Arm_Motor.obj"/>
    <mesh name="Lower_Arm" file="Lower_Arm.obj"/>
    <mesh name="Lower_Arm_Motor" file="Lower_Arm_Motor.obj"/>
    <mesh name="Wrist_Pitch_Roll" file="Wrist_Pitch_Roll.obj"/>
    <mesh name="Wrist_Pitch_Roll_Motor" file="Wrist_Pitch_Roll_Motor.obj"/>
    <mesh name="Fixed_Jaw" file="Fixed_Jaw.obj"/>
    <mesh name="Fixed_Jaw_Motor" file="Fixed_Jaw_Motor.obj"/>
    <mesh name="Moving_Jaw" file="Moving_Jaw.obj"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 2" mode="fixed"/>
    <geom name="floor" size="0 0 0.1" type="plane" rgba="0.9 0.9 0.9 1"/>

    <body name="Base" childclass="so_arm100">
      <geom type="mesh" mesh="Base"/>
      <geom type="mesh" mesh="Base_Motor" material="black"/>

      <body name="Rotation_Pitch" pos="0 -0.0452 0.0165" quat="0.707105 0.707108 0 0">
        <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504" mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05"/>
        <joint name="Rotation" class="Rotation"/>
        <geom type="mesh" mesh="Rotation_Pitch"/>
        <geom type="mesh" mesh="Rotation_Pitch_Motor" material="black"/>

        <body name="Upper_Arm" pos="0 0.1025 0.0306" euler="0 0 0">
          <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632" mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05"/>
          <joint name="Pitch" class="Pitch"/>
          <geom type="mesh" mesh="Upper_Arm"/>
          <geom type="mesh" mesh="Upper_Arm_Motor" material="black"/>

          <body name="Lower_Arm" pos="0 0.11257 0.028" euler="0 0 0">
            <inertial pos="-0.00339604 0.00137796 0.0768007" quat="0.701995 0.0787996 0.0645626 0.704859" mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05"/>
            <joint name="Elbow" class="Elbow"/>
            <geom type="mesh" mesh="Lower_Arm"/>
            <geom type="mesh" mesh="Lower_Arm_Motor" material="black"/>

            <body name="Wrist_Pitch_Roll" pos="0 0.0052 0.1349" euler="0 0 0">
              <inertial pos="-0.00852653 -0.0352279 -2.34622e-05" quat="-0.0522806 0.705235 0.0549524 0.704905" mass="0.0661321" diaginertia="3.45403e-05 2.39041e-05 1.94704e-05"/>
              <joint name="Wrist_Pitch" class="Wrist_Pitch"/>
              <geom type="mesh" mesh="Wrist_Pitch_Roll"/>
              <geom type="mesh" mesh="Wrist_Pitch_Roll_Motor" material="black"/>

              <body name="Fixed_Jaw" pos="0 -0.0601 0" euler="0 1.57079 0">
                <inertial pos="0.00552377 -0.0280167 0.000483583" quat="0.41836 0.620891 -0.350644 0.562599" mass="0.0929859" diaginertia="5.03136e-05 4.64098e-05 2.72961e-05"/>
                <joint name="Wrist_Roll" class="Wrist_Roll"/>
                <geom type="mesh" mesh="Fixed_Jaw"/>
                <geom type="mesh" mesh="Fixed_Jaw_Motor" material="black"/>

                <body name="Moving_Jaw" pos="-0.0202 -0.0244 0" quat="1.34924e-11 -3.67321e-06 1 -3.67321e-06">
                  <inertial pos="-0.00161745 -0.0303473 0.000449646" quat="0.696562 0.716737 -0.0239844 -0.0227026" mass="0.0202444" diaginertia="1.11265e-05 8.99651e-06 2.99548e-06"/>
                  <joint name="Jaw" class="Jaw"/>
                  <geom type="mesh" mesh="Moving_Jaw"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="Rotation" joint="Rotation" gear="50" ctrllimited="true" ctrlrange="-2 2"/>
    <motor name="Pitch" joint="Pitch" gear="40" ctrllimited="true" ctrlrange="-2 2"/>
    <motor name="Elbow" joint="Elbow" gear="40" ctrllimited="true" ctrlrange="-2 2"/>
    <motor name="Wrist_Pitch" joint="Wrist_Pitch" gear="25" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="Wrist_Roll" joint="Wrist_Roll" gear="25" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="Jaw" joint="Jaw" gear="20" ctrllimited="true" ctrlrange="-0.5 0.5"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 -1.57 1.57 1.57 -1.57 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
